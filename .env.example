ENVIRONMENT=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key

# Local database
DATABASE_URL=sqlite+aiosqlite:///./rag_dev.db

# Local Ollama LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_MAX_TOKENS=650

# Local embeddings. Use Ollama by default because it needs no paid API.
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional alternative if installed:
# EMBED_PROVIDER=huggingface
# HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local background processing
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=storage/uploads/pdfs
TEMP_DIR=storage/uploads/temp
PROCESSED_DIR=storage/processed
MAX_UPLOAD_SIZE_MB=50

# Vector DB
CHROMA_PERSIST_DIR=vectordb/chroma
CHROMA_COLLECTION_PREFIX=rag

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=3
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_CONTEXT_TOKEN_BUDGET=1800

# Frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
